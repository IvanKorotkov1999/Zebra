{
    "name": "avoxe/backend",
    "description": "Avoxe site backend (Yii2 API + SPA host)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "yiisoft/yii2": "~2.0.49"
    },
    "replace": {
        "bower-asset/jquery": ">=1.11.0",
        "bower-asset/inputmask": ">=3.2.0",
        "bower-asset/punycode": ">=1.3.0",
        "bower-asset/yii2-pjax": ">=2.0.0"
    },
    "autoload": {
        "psr-4": {
            "app\\": ""
        }
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        },
        "sort-packages": true
    }
}
